{
  "name": "extension",
  "private": true,
  "version": "0.4.0",
  "description": "penciled for the browser: highlight and take notes on any web page.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "lint:firefox": "wxt build -b firefox && web-ext lint -s .output/firefox-mv3 --self-hosted=false",
    "zip": "wxt zip && wxt zip -b edge && wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "icons": "node scripts/icons.ts",
    "screenshots": "wxt build && playwright test --config store/playwright.config.ts"
  },
  "dependencies": {
    "penciled": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
